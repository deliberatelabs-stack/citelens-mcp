{
  "name": "citelens-mcp",
  "version": "0.1.0",
  "description": "MCP server for Bing Webmaster Tools, IndexNow, and AI citation analysis",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "citelens-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "indexnow",
    "webmaster",
    "ai-citations",
    "seo"
  ],
  "author": "deliberatelabs-stack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deliberatelabs-stack/citelens-mcp.git"
  },
  "homepage": "https://github.com/deliberatelabs-stack/citelens-mcp#readme",
  "bugs": {
    "url": "https://github.com/deliberatelabs-stack/citelens-mcp/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.0.0",
    "csv-parse": "^5.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
